{
  "name": "expo-poste-bf-api",
  "version": "0.1.0",
  "private": true,
  "description": "API REST de l'exposition virtuelle La Poste Burkina Faso",
  "type": "module",
  "engines": { "node": ">=22.9" },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx --env-file-if-exists=.env src/cli/migrate.ts",
    "seed": "tsx --env-file-if-exists=.env src/cli/seed.ts",
    "import": "tsx --env-file-if-exists=.env src/cli/import.ts",
    "test": "tsx --env-file-if-exists=.env --test test/*.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/static": "^8.0.2",
    "csv-parse": "^5.5.6",
    "fastify": "^5.1.0",
    "pg": "^8.13.1",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}

# Copier ce fichier en .env puis adapter les valeurs.
PORT=4000
# Connexion PostgreSQL (la valeur par défaut correspond à docker-compose.yml)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/expo_poste
# Dossier des fichiers servis sur /files : images/, miniatures/, models/, audio/, media/
MEDIA_DIR=./media
# URL publique de l'API, utilisée pour construire les liens absolus vers les fichiers
PUBLIC_URL=http://localhost:4000
# Origines autorisées (séparées par des virgules), ou * pour tout autoriser en développement
CORS_ORIGIN=http://localhost:5173
# false = masque les pièces importées dont les informations sont à vérifier
SHOW_UNVERIFIED=true
